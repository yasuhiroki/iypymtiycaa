#!/usr/bin/env zsh
# > Record and share your terminal sessions, the right way
# > https://asciinema.org/

function zshef::install::osx() {
    zshef::util::mng::is_installed "asciinema" || {
        zshef::util::os::mac::install "asciinema"
    }
}

function zshef::update::osx() {
    zshef::util::mng::is_installed "asciinema" && {
        zshef::util::os::mac::update "asciinema"
    }
}

function zshef::install::debian() {
    zshef::util::mng::is_installed "asciinema" || {
        zshef::util::os::debian::install "asciinema"
    }
}

function zshef::update::debian() {
    zshef::util::mng::is_installed "asciinema" && {
        zshef::util::os::debian::update "asciinema"
    }
}
