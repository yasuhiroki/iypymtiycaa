#!/usr/bin/env zsh

function zshef::install::osx() {
    zshef::util::mng::is_installed "rg" || {
        zshef::util::os::mac::install "ripgrep"
    }
}

function zshef::update::osx() {
    zshef::util::mng::is_installed "rg" && {
        zshef::util::os::mac::update "ripgrep"
    }
}

function zshef::install::debian() {
    zshef::util::mng::is_installed "rg" || {
        zshef::util::os::debian::install "ripgrep"
    }
}

function zshef::update::debian() {
    zshef::util::mng::is_installed "rg" && {
        zshef::util::os::debian::update "ripgrep"
    }
}

