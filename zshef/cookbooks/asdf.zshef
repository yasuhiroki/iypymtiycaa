#!/usr/bin/env zsh

source ${${(%):-%N}:A:h}/asdf/_func.sh

function zshef::install::macos() {
    zshef::util::mng::is_installed "asdf" || {
        zshef::util::os::install "asdf"
    }
}

function zshef::update::macos() {
    zshef::util::mng::is_installed "asdf" && {
        zshef::util::os::update "asdf"
    }
}

ASDF_VERSION="v0.20.2"

function zshef::install::debian() {
    zshef::util::mng::is_installed "asdf" || {
        local arch="$(dpkg --print-architecture)"
        curl -sSL https://github.com/asdf-vm/asdf/releases/download/${ASDF_VERSION}/asdf-${ASDF_VERSION}-linux-${arch:?}.tar.gz -o asdf.tar.gz
        tar -xzf asdf.tar.gz && sudo mv asdf /usr/local/bin/ && rm asdf.tar.gz
    }
}

function zshef::update::debian() {
    zshef::util::mng::is_installed "asdf" && {
        local arch="$(dpkg --print-architecture)"
        curl -sSL https://github.com/asdf-vm/asdf/releases/download/${ASDF_VERSION}/asdf-${ASDF_VERSION}-linux-${arch:?}.tar.gz -o asdf.tar.gz
        tar -xzf asdf.tar.gz && sudo mv asdf /usr/local/bin/ && rm asdf.tar.gz
    }
}

function zshef::config() {
    mkdir -p "${HOME}/.iypymtiycaa/env"
    local rc="${HOME}/.iypymtiycaa/env/$(my::asdf::rc::name)"
    : > ${rc}
    echo 'export GOPATH=$HOME/go' >> ${rc}
    echo 'eval $(asdf info | grep "^ASDF_DATA_DIR=")' >> ${rc}
    echo 'path=($ASDF_DATA_DIR/shims $path)' >> ${rc}
    echo 'export PATH' >> ${rc}
}

