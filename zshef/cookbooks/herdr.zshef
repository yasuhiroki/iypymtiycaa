#!/usr/bin/env zsh

function zshef::install::osx() {
    zshef::util::mng::is_installed "herdr" || {
        zshef::util::os::mac::install "herdr"
    }
}


function zshef::update::osx() {
    zshef::util::mng::is_installed "herdr" && {
        zshef::util::os::mac::update "herdr"
    }
}

function zshef::install::debian() {
    zshef::util::mng::is_installed "herdr" || {
        curl -fsSL https://herdr.dev/install.sh | sh
    }
}

function zshef::update::debian() {
    zshef::util::mng::is_installed "herdr" && {
        curl -fsSL https://herdr.dev/install.sh | sh
    }
}
