#!/usr/bin/env zsh

source ${${(%):-%N}:A:h}/asdf/_func.sh

function zshef::install::osx() {
    zshef::util::os::mac::install "python"
    zshef::util::os::mac::install "uv"
}

function zshef::update::osx() {
    zshef::util::os::mac::update "python"
    zshef::util::os::mac::update "uv"
}

function zshef::install::debian() {
    zshef::util::mng::is_installed "python" && zshef::util::mng::is_installed "pip" || {
        zshef::util::os::debian::install "python3" "python3-pip" "python3-venv" "python-is-python3"
    }
}

function zshef::update::debian() {
    zshef::util::mng::is_installed "python3" && {
        zshef::util::os::debian::update "python3" "python3-pip" "python3-venv" "python-is-python3"
    }
}

function zshef::config::osx() {
    mkdir -p ~/.iypymtiycaa/env
    cat <<EOH > ~/.iypymtiycaa/env/pythonrc.sh
path=("\$(brew --prefix)/opt/python/libexec/bin" \$path)
export PATH
EOH
}
