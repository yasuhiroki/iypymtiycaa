#!/usr/bin/env zsh

function zshef::install::osx() {
    zshef::util::mng::is_installed "vim" || {
        zshef::util::os::mac::install "vim"
        my::depends::osx
    }
}

function zshef::update::osx() {
    zshef::util::mng::is_installed "vim" && {
        zshef::util::os::mac::update "vim"
    }
}

function zshef::install::debian() {
    zshef::util::mng::is_installed "vim" || {
        zshef::util::os::debian::install "vim"
    }
}

function zshef::update::debian() {
    zshef::util::mng::is_installed "vim" && {
        zshef::util::os::debian::update "vim"
    }
}

function my::depends::osx() {
    brew install cmake boost lua@5.3
}

