#!/usr/bin/env zsh

function zshef::install::osx() {
    zshef::util::os::mac::is_installed "keepassxc" || {
        zshef::util::os::mac::install "keepassxc"
    }
}

function zshef::update::osx() {
    zshef::util::os::mac::is_installed "keepassxc" &&{
        zshef::util::os::mac::update "keepassxc"
    }
}
