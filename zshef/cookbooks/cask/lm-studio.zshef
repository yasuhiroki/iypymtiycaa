#!/usr/bin/env zsh

function zshef::install::osx() {
    zshef::util::os::mac::is_installed "lm-studio" || {
        zshef::util::os::mac::install "lm-studio"
    }
}

function zshef::config() {
    mkdir -p ~/.iypymtiycaa/env
    echo 'path=("$HOME/.lmstudio/bin" $path)' > ~/.iypymtiycaa/env/lm-studio.sh
}
