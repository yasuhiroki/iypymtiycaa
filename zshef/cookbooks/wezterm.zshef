#!/usr/bin/env zsh

function zshef::config() {
    local dir="${${(%):-%N}:A:h}/cookbooks/wezterm"
    mkdir -p ~/.iypymtiycaa/rc ~/.iypymtiycaa/zsh/completions
    cp ${dir}/weztermrc.sh ~/.iypymtiycaa/rc/

    mkdir -p ~/.config/wezterm/plugin/
    cp ${dir}/wezterm.lua ~/.config/wezterm/
    cp -r ${dir}/plugin/. ~/.config/wezterm/plugin/

    zshef::util::mng::is_installed "wezterm" && {
        wezterm shell-completion --shell zsh > ~/.iypymtiycaa/zsh/completions/_wezterm
    }
}
