#!/usr/bin/env zsh

function zshef::install::osx() {
    zshef::util::mng::is_installed "aws" || {
        zshef::util::os::mac::install "awscli"
    }
    zshef::util::mng::is_installed "ecs-cli" || {
        my::download::osx::awsecscli::latest
    }
    zshef::util::mng::is_installed "sam" || {
        zshef::util::os::mac::install "aws-sam-cli"
    }
}

function zshef::update::osx() {
    zshef::util::mng::is_installed "aws" && {
        zshef::util::os::mac::update "awscli"
    }
    zshef::util::mng::is_installed "ecs-cli" && {
        my::download::osx::awsecscli::latest
    }
    zshef::util::mng::is_installed "sam" && {
        zshef::util::os::mac::update "aws-sam-cli"
    }
}

function zshef::install::debian() {
    zshef::util::mng::is_installed "aws" || {
        my::install::debian::awscli
    }
    zshef::util::mng::is_installed "sam" || {
        my::install::debian::sam
    }
}

function zshef::update::debian() {
    zshef::util::mng::is_installed "aws" && {
        my::install::debian::awscli
    }
    zshef::util::mng::is_installed "sam" && {
        my::install::debian::sam
    }
}

function zshef::config() {
    mkdir -p ~/.iypymtiycaa/rc
    local completer="$(command -v aws_completer || echo /usr/local/aws-cli/aws_completer)"
    echo "complete -C '${completer}' aws" > ~/.iypymtiycaa/rc/awsclirc.sh
}

function my::install::debian::awscli() {
    local arch
    case "$(uname -m)" in
        x86_64) arch="x86_64" ;;
        aarch64|arm64) arch="aarch64" ;;
        *)
            zshef::util::log::error "Unsupported architecture: $(uname -m)"
            return 1
            ;;
    esac

    local tmpdir
    tmpdir="$(mktemp -d)" || return 1
    curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${arch}.zip" -o "${tmpdir}/awscliv2.zip" \
        && unzip -q "${tmpdir}/awscliv2.zip" -d "${tmpdir}" \
        && sudo "${tmpdir}/aws/install" --update
    local rc=$?
    rm -rf "${tmpdir}"
    return ${rc}
}

function my::install::debian::sam() {
    local arch
    case "$(uname -m)" in
        x86_64) arch="x86_64" ;;
        aarch64|arm64) arch="arm64" ;;
        *)
            zshef::util::log::error "Unsupported architecture: $(uname -m)"
            return 1
            ;;
    esac

    local tmpdir
    tmpdir="$(mktemp -d)" || return 1
    curl -fsSL "https://github.com/aws/aws-sam-cli/releases/latest/download/aws-sam-cli-linux-${arch}.zip" -o "${tmpdir}/aws-sam-cli.zip" \
        && unzip -q "${tmpdir}/aws-sam-cli.zip" -d "${tmpdir}/sam-installation" \
        && sudo "${tmpdir}/sam-installation/install" --update
    local rc=$?
    rm -rf "${tmpdir}"
    return ${rc}
}

function my::url::awsecscli::osx() {
    echo "https://s3.amazonaws.com/amazon-ecs-cli/ecs-cli-darwin-amd64"
}

function my::download::osx::awsecscli::latest() {
    curl $(my::url::awsecscli::osx)-latest -o ~/mybin/ecs-cli
    chmod 755 ~/mybin/ecs-cli
}
