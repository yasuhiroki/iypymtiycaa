#!/usr/bin/env zsh

function zshef::install() {
    :
}

function zshef::update() {
    :
}

function zshef::config() {
    local dir="${${(%):-%N}:A:h}/cookbooks/zsh"
    cp ${dir}/zshenv ~/.zshenv
    cp ${dir}/zshrc ~/.zshrc
    cp ${dir}/zimrc ~/.zimrc

    mkdir -p ~/.iypymtiycaa/env ~/.iypymtiycaa/rc

    cat <<EOH > ~/.iypymtiycaa/env/_path.sh
path=("/usr/local/sbin" \$path)
path=("\$HOME/mybin" \$path)
path=("\$HOME/.local/bin" \$path)
export PATH
EOH
}

function zshef::config::osx() {
    mkdir -p ~/.iypymtiycaa/env
    cat <<EOH > ~/.iypymtiycaa/env/_path_brew.sh
path=("/opt/homebrew/sbin" \$path)
path=("/opt/homebrew/bin" \$path)
export PATH
EOH
}

