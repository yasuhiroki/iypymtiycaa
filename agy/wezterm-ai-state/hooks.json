{
  "wezterm-ai-state": {
    "SessionStart": [
      {
        "type": "command",
        "command": "sh ./set-state.sh idle",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "sh ./set-state.sh running",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "sh ./set-state.sh ask '{\"decision\":\"allow\"}'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "sh ./set-state.sh running",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "sh ./set-state.sh complete '{\"decision\":\"stop\"}'",
        "timeout": 5
      }
    ]
  }
}
